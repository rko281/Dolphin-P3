| package |
package := Package name: 'P3-Tests'.
package paxVersion: 1;
	basicComment: ''.

package classNames
	add: #P3ArrayValueParserTest;
	add: #P3ClientTest;
	add: #P3ConnectionPoolTest;
	add: #P3FormattedStatementTest;
	add: #P3IntegerVectorValueParserTest;
	add: #P3ISO8601ParserTest;
	add: #P3PBKDF2Test;
	add: #P3PreparedStatementTest;
	add: #P3SCRAMTest;
	yourself.

package methodNames
	add: #P3Client -> #utcOffset;
	yourself.

package binaryGlobalNames: (Set new
	yourself).

package globalAliases: (Set new
	yourself).

package setPrerequisites: #(
	'..\Core\Object Arts\Dolphin\Base\Dolphin'
	'..\Core\Object Arts\Dolphin\Base\Dolphin Legacy Date & Time'
	'..\Core\Object Arts\Dolphin\System\Random\Dolphin Random Stream'
	'P3'
	'..\Core\Contributions\svenc\STON\STON-Core'
	'..\Core\Contributions\Camp Smalltalk\SUnit\SUnit').

package!

