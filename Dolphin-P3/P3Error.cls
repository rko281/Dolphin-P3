"Filed out from Dolphin Smalltalk"!

Error subclass: #P3Error
	instanceVariableNames: 'info'
	classVariableNames: ''
	poolDictionaries: ''
	classInstanceVariableNames: ''!

P3Error guid: (GUID fromString: '{db19bab9-b4ed-4d01-87af-616b9d1ea82b}')!

P3Error comment: 'I am P3Error.I get signalled when something goes wrong in using P3Client, either an error inside the driver itself, or an error signalled by the PostgreSQL database backend server.I should always have a unique code and a message.Use #isLocal to distinguish between an error inside the driver itself, or an error signalled by the PostgreSQL database backend server.Reference https://www.postgresql.org/docs/9.6/errcodes-appendix.html'!

!P3Error categoriesForClass!P3-Core! !

!P3Error methodsFor!

code	"Return my unique, locale independent, 5 character string code.	The first 2 characters are called the class.	The special P3 class groups errors that were generated locally,	as opposed to error generated by the PostgreSQL server"		^ self info at: $C ifAbsent: [ nil ]!

description	"Return a textual description of the exception."	^ String streamContents: [ :stream |		stream << self class name.		self isLocal 			ifFalse: [ stream space; << 'PostgreSQL' ].		(self messageText ifNil: ['']) isEmpty			ifFalse: [ stream space; << self messageText ] ]!

info	"An info dictionary contains the fields as described in 	https://www.postgresql.org/docs/9.6/protocol-error-fields.html"	^ info ifNil: [ info := Dictionary new ]!

info: anObject	info := anObject!

isLocal	"Return true when I represent an error inside P3 itself,	as opposed to an error generated by the PostgreSQL server"		^ self code 		ifNil: [ true "if there is no code, we might have been initialized directly" ] 		ifNotNil: [ :code | code beginsWith: 'P3' ]!

message	"Return my user oriented error message string.	This could be locale dependent.	My messageText gets initialized from this string"	^ self info at: $M ifAbsent: [ '' ]!

messageText	^ messageText ifNil: [ messageText := self message ]! !

!P3Error categoriesForMethods!
code!accessing!public! !
description!accessing!public! !
info!accessing!public! !
info:!accessing!public! !
isLocal!public!testing! !
message!accessing!public! !
messageText!accessing!public! !
!

!P3Error class methodsFor!

bindCompleteExpected	^ self new 		info: { $C->'P3004'. $M->'BindComplete message expected' } asDictionary; 		yourself!

cannotConvertTypeOid: typeOid	^ self new 		info: { $C->'P3030'. $M->('Cannot convert type with OID {1}' format: { typeOid }) } asDictionary; 		yourself!

closeCompleteExpected	^ self new 		info: { $C->'P3005'. $M->'CloseComplete message expected' } asDictionary; 		yourself!

noDataExpected	^ self new 		info: { $C->'P3001'. $M->'NoData message expected' } asDictionary; 		yourself!

parseCompleteExpected	^ self new 		info: { $C->'P3002'. $M->'ParseComplete message expected' } asDictionary; 		yourself!

parsingFailed: detail	^ self new 		info: { $C->'P3031'. $M->('Parsing failed "{1}"' format: { detail }) } asDictionary; 		yourself!

passwordRequired	^ self new 		info: { $C->'P3010'. $M->'Password required' } asDictionary; 		yourself!

postgreSQLServerDidNotHonorSSLConnectionRequest	^ self new 		info: { $C->'P3040'. $M->'PostgreSQL server did not honor SSL connection request' } asDictionary; 		yourself!

readyForQueryExpected	^ self new 		info: { $C->'P3003'. $M->'ReadyForQuery message expected' } asDictionary; 		yourself!

unexpectedMessageDuringAuthentication	^ self new 		info: { $C->'P3020'. $M->'Unexpected message during authentication' } asDictionary; 		yourself!

unexpectedMessageDuringStartup	^ self new 		info: { $C->'P3021'. $M->'Unexpected message during startup' } asDictionary; 		yourself!

unsupportedAuthenticationType: type	^ self new 		info: { $C->'P3022'. $M->('Unsupported authentication type {1}' format: { type }) } asDictionary; 		yourself! !

