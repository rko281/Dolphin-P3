	add: #Time -> #p3PrintUsing:on:;
	add: #TimeStamp -> #p3PrintUsing:on:;
	add: #UndefinedObject -> #p3PrintUsing:on:;
	add: 'Integer class' -> #p3readFromByteStream:length:;
	yourself.

package binaryGlobalNames: (Set new
	yourself).

package globalAliases: (Set new
	yourself).

package setPrerequisites: #(
	'..\Core\Object Arts\Dolphin\Base\Dolphin'
	'..\Core\Object Arts\Dolphin\System\Announcements\Dolphin Announcements'
	'..\Core\Object Arts\Dolphin\Base\Dolphin Legacy Date & Time'
	'..\Core\Object Arts\Dolphin\System\Random\Dolphin Random Stream'
	'..\Core\Object Arts\Dolphin\Sockets\Dolphin Sockets'
	'..\Core\Object Arts\Dolphin\DolphinSure\DolphinSure'
	'..\Core\Contributions\svenc\STON\STON-Core'
	'..\OpenSSL\TLS Sockets').

