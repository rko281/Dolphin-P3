!DateAndTime methodsFor!

p3PrintUsing: delegate on: stream	"Print me on stream via double dispatch on delegate.	Check the implementors of #p3PrintUsing:on:"	delegate printDateAndTime: self on: stream!

p3translateTo: anOffset
	"Keep myself's representation and move it to another timezone offset.
	Note that unlike #offset: this WILL change the absolute time in UTC

	|t|
	t := DateAndTime now.
	t = (t offset: 2 hours).
	t = (t translateTo: 2 hours).
	"
	^self dayMonthYearDo: [ :day :month :year|
		self class
			year: year
			month: month
			day: day
			hour: self hour
			minute: self minute
			second: self second
			offset: anOffset asDuration]! !

!DateAndTime categoriesForMethods!
p3PrintUsing:on:!*P3!public! !
p3translateTo:!*P3!public! !
!

!Integer class methodsFor!

p3readFromByteStream: aStream length: anInteger

	| neg value  |

	neg := aStream peekFor: ##($- asciiValue).
	value := 0.
	(neg ifTrue: [anInteger - 1] ifFalse: [anInteger]) timesRepeat: [value := value * 10 + (aStream next - 48)].
	
	^neg 
		ifTrue: [value negated] 
		ifFalse: [value]! !

!Integer class categoriesForMethods!
p3readFromByteStream:length:!instance creation!public! !
!

!Object methodsFor!

p3PrintUsing: delegate on: stream	"Print me on stream via double dispatch on delegate.	This is the default/fallback implementation.	Check the implementors of #p3PrintUsing:on:"		delegate printObject: self on: stream! !

!Object categoriesForMethods!
p3PrintUsing:on:!*P3!public! !
!

!PositionableStream methodsFor!

p3setFrom: anInteger to: sizeInteger

	position := anInteger - 1.
	readLimit := sizeInteger! !

!PositionableStream categoriesForMethods!
p3setFrom:to:!initializing!public! !
!

!ReadStream methodsFor!

p3uint16
	"Answer the next unsigned, 16-bit integer from this (binary) stream."

	| n |
	n := self next.
	n := (n bitShift: 8) + (self next).
	^ n!

p3uint32
	"Answer the next unsigned, 16-bit integer from this (binary) stream."

	| n |
	n := self next.
	n := (n bitShift: 24) + (self next bitShift: 16) + (self next bitShift: 8) + (self next).
	^ n! !

!ReadStream categoriesForMethods!
p3uint16!accessing!public! !
p3uint32!accessing!public! !
!

