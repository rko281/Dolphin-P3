package methodNames
	add: #BCryptLibrary -> #p3bCryptHash:pbSecret:cbSecret:pbInput:cbInput:pbOutput:cbOutput:;
	add: #BCryptLibrary -> #p3hash:algorithm:length:;
	add: #ByteArray -> #p3PrintUsing:on:;
	add: #Date -> #p3PrintUsing:on:;
	add: #DateAndTime -> #p3PrintUsing:on:;
	add: #DateAndTime -> #p3translateTo:;
	add: #Object -> #p3PrintUsing:on:;
	add: #PositionableStream -> #p3setFrom:to:;
	add: #ReadStream -> #p3uint16;
	add: #ReadStream -> #p3uint32;
